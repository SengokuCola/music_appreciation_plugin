{
  "manifest_version": 2,
  "id": "SengokuCola.music-appreciation-plugin",
  "name": "音乐赏析",
  "version": "0.1.0",
  "description": "让麦麦从网易云获取歌曲（歌名或链接），并通过百炼 Qwen-Omni 真正听歌赏析。",
  "author": {
    "name": "SengokuCola",
    "url": "https://github.com/SengokuCola"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/SengokuCola/music_appreciation_plugin",
    "homepage": "https://github.com/SengokuCola/music_appreciation_plugin",
    "documentation": "https://github.com/SengokuCola/music_appreciation_plugin/blob/main/README.md",
    "issues": "https://github.com/SengokuCola/music_appreciation_plugin/issues"
  },
  "changelog": "changelog.md",
  "host_application": {
    "min_version": "1.3.4",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.9.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.28.1,<1"
    }
  ],
  "capabilities": [
    "send.text"
  ],
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "music",
      "background": "#2B1B3D"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
